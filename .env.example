# ==============================================================================
# Customer Support Agent - Environment Configuration Example
# ==============================================================================
# All settings below have robust local defaults. None are mandatory.
# Copy this file to .env if you wish to override any setting.

# 1. HuggingFace Token (Optional: increases rate limits for model weight downloads)
# HF_TOKEN=hf_your_token_here

# 2. Local Ollama LLM Endpoint (Optional: used for local LLM-as-a-judge generation)
# If Ollama is offline or not installed, the evaluation harness automatically
# falls back to a calibrated deterministic heuristic rubric with zero crashes.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# 3. Hardware Compute Device (Optional override: 'cuda' or 'cpu')
# Defaults to auto-detecting CUDA availability (NVIDIA GPU).
DEVICE=cuda

# 4. Agent Decision Policy Confidence Threshold
# Normalized temperature-scaled margin threshold across 8 classes (chance = 0.125).
# Values above threshold permit AUTO_HANDLE for routine categories.
CONFIDENCE_THRESHOLD=0.20

# 5. Retrieval Store Size
# Maximum historical conversation records to index in FAISS vector store
MAX_RETRIEVAL_RECORDS=2000
