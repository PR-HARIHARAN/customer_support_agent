data/faiss_customer_message/index.*
data/faiss_full_conversation/index.*
data/processed/customer_messages_with_candidate_intent*_v1.jsonl
data/processed/conversations_with_intents_full_v1.jsonl

# Unvalidated / large experiment artifacts, kept locally for reference only.
data/retired/
data/processed/experiments/*.pt
data/processed/experiments/*.npz
data/processed/experiments/*encoder/

# Runtime backup produced by label_app.py on every save.
data/processed/golden_set.backup.csv

